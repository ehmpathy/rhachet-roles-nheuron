exports[`repo skills given: [case4] aws.caller.get when: [t0] help is asked for then: the help surface is pinned 1`] = `
"🐈 heres the deal...

⛵ aws.caller.get
   ├─ usage: rhx aws.caller.get --env <env> [--org <org>] [--expect management|member]
   ├─ options
   │  ├─ --env     keyrack env: sudo, prep, prod, or test (required)
   │  ├─ --org     keyrack org (optional; default: the repo's default org)
   │  └─ --expect  management = the account manages its aws organization
   │               member = the account belongs to an org it does not manage
   └─ example
      └─ rhx aws.caller.get --env sudo --expect management
"
`;

