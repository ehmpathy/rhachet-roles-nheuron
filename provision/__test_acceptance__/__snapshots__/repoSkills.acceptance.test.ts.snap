exports[`repo skills given: [live2] mail.dns.records.get --env prep (TEST_LIVE=ses) when: [t0] it runs against the live prep account then: the result surface is pinned, masked 1`] = `
"🐈 heres the chart...

⛵ mail.dns.records.get --env prep
   ├─ zone: nheuron.com
   ├─ proxy: off (dns only, grey cloud) on every record
   ├─ records (6)
   │  ├─ MX
   │  │  ├─ name: one.prep.nheuron.com
   │  │  ├─ priority: 10
   │  │  └─ value: inbound-smtp.us-east-1.amazonaws.com
   │  ├─ TXT
   │  │  ├─ name: one.prep.nheuron.com
   │  │  └─ value: v=spf1 include:amazonses.com ~all
   │  ├─ CNAME
   │  │  ├─ name: <dkim>._domainkey.one.prep.nheuron.com
   │  │  └─ value: <dkim>.dkim.amazonses.com
   │  ├─ CNAME
   │  │  ├─ name: <dkim>._domainkey.one.prep.nheuron.com
   │  │  └─ value: <dkim>.dkim.amazonses.com
   │  ├─ CNAME
   │  │  ├─ name: <dkim>._domainkey.one.prep.nheuron.com
   │  │  └─ value: <dkim>.dkim.amazonses.com
   │  └─ TXT
   │     ├─ name: _dmarc.one.prep.nheuron.com
   │     └─ value: v=DMARC1; p=none
   │
   └─ SES_DKIM_TOKENS segment (join the envs with ;)
      └─ one.prep.nheuron.com=<dkim>,<dkim>,<dkim>
"
`;

