exports[`repo skills given: [case5] provision.member when: [t0] help is asked for then: the help surface is pinned 1`] = `
"🐈 heres the deal...

⛵ provision.member
   ├─ usage: rhx provision.member --wish <path> --env <env> [--org <org>] --mode <mode>
   ├─ options
   │  ├─ --wish   path to a declastruct resources.ts (required)
   │  ├─ --env    keyrack env: test, prep, or prod (required)
   │  ├─ --org    keyrack org (optional; default: the repo's default org)
   │  ├─ --mode   plan or apply (required)
   │  └─ --plan   plan file path (optional; defaults to <wish>.plan.json)
   └─ example
      └─ rhx provision.member --wish provision/aws.mail/account=prod/resources.mail.ts --env prod --org nheuron --mode plan
"
`;

