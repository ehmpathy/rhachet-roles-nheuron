exports[`repo skills given: [case6] provision.root when: [t0] help is asked for then: the help surface is pinned 1`] = `
"🐈 heres the deal...

⛵ provision.root
   ├─ usage: rhx provision.root --wish <path> --mode <mode>
   ├─ options
   │  ├─ --wish   path to a declastruct resources.ts (required)
   │  ├─ --mode   plan or apply (required)
   │  ├─ --plan   plan file path (optional; defaults to <wish>.plan.json)
   │  └─ --key    an extra sudo key the wish reads (repeatable; AWS_PROFILE is always unlocked)
   └─ example
      └─ rhx provision.root --wish provision/aws.budget/account=.root/resources.ts --mode plan
"
`;

