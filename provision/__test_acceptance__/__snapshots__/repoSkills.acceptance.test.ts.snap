exports[`repo skills given: [case7] package.patch when: [t0] help is asked for then: the help surface is pinned 1`] = `
"🐈 heres the deal...

⛵ package.patch
   ├─ usage: rhx package.patch --package <name>@<version> --mode open|commit
   ├─ options
   │  ├─ --package  the installed package to patch, as name@version (required)
   │  └─ --mode     open = copy it out to edit · commit = write patches/*.patch (required)
   └─ example
      ├─ rhx package.patch --package declastruct-aws@1.13.0 --mode open
      ├─ edit files under .temp/patch.declastruct-aws@1.13.0/
      └─ rhx package.patch --package declastruct-aws@1.13.0 --mode commit
"
`;

exports[`repo skills given: [case7] package.patch when: [t1] it is called with no args then: the refusal surface is pinned 1`] = `
{
  "stderr": "",
  "stdout": "🐈 belay that...

⛵ package.patch
   ├─ absent required arg: --package
   └─ fix: pass name@version, e.g. declastruct-aws@1.13.0
",
}
`;

