exports[`gather.mail given: [case5] ses collection with no aws configured when: [t0] SES_MAIL_BUCKET and SES_REGION are absent then: exits 2 and names the keyrack unlock, never gather.auth 1`] = `
"✋ ConstraintError: not authenticated

{
  "mechanism": "ses",
  "hint": "ses authenticates via AWS_PROFILE. run: rhx keyrack unlock --owner ehmpath --env prep"
}
"
`;

