exports[`gather.mail given: [case5] not authenticated (auth check exercises) when: [t0] no token exists for address then: exits with clear error and hint 1`] = `
"✋ ConstraintError: BadRequestError: not authenticated

{
  "mechanism": "gmail",
  "hint": "gmail authenticates via a service account. fill GMAIL_SERVICE_ACCOUNT_JSON + GMAIL_SERVICE_ACCOUNT_SUBJECT, then run: rhx keyrack unlock --owner ehmpath --env test"
}
"
`;

exports[`gather.mail given: [case6] positive path constraint: gmail api requires real credentials when: [t0] authenticated with fake token (gmail api rejects) then: exits with api error (proves full flow path) 1`] = `
