}
"
`;

exports[`gather.mail given: [case8] an address with a path suffix when: [t0] gather.mail is invoked with --address jelly@one.nheuron.com/inbox then: exits 2 and names the one-address shape 1`] = `
"✋ ConstraintError: address 'jelly@one.nheuron.com/inbox' is not a mailbox address

{
  "address": "jelly@one.nheuron.com/inbox",
  "why": "the address names the mailbox and its cache dir, so it must be one plain email address",
  "hint": "pass one address, e.g. --address jelly@one.nheuron.com"
}
"
`;

exports[`gather.mail given: [case9] an unreadable --since when: [t0] gather.mail is invoked with --since yesterday then: exits 2 and names an iso date, before any auth check 1`] = `
"✋ ConstraintError: --since is not a date we can read

{
  "since": "yesterday",
  "why": "an unreadable date would silently become no bound at all, and return the whole mailbox",
  "hint": "use an ISO date, e.g. --since 2026-08-01"
}
"
`;

