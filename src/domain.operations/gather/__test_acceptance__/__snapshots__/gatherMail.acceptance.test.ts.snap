exports[`gather.mail given: [case9] a --query against ses, which cannot honor one when: [t0] gather.mail is invoked with --query then: exits 2 and refuses the flag, rather than return it all 1`] = `
"✋ ConstraintError: BadRequestError: ses cannot honor --query

{
  "filter": {
    "query": "from:boss@company.com",
    "labels": []
  },
  "why": "ses mail is read from an s3 prefix of raw rfc822; there is no search index to query",
  "hint": "narrow with --since instead, or use --from gmail for a search expression"
}
"
`;

exports[`gather.mail given: [case10] a /labels= scope against ses when: [t0] gather.mail is invoked with a scoped address then: exits 2 and names the suffix to drop 1`] = `
"✋ ConstraintError: BadRequestError: ses cannot honor a /labels= scope

{
  "filter": {
    "query": null,
    "labels": [
      "work"
    ]
  },
  "why": "labels are a gmail concept; rfc822 mail in s3 carries none",
  "hint": "drop the /labels= suffix from --address"
}
"
`;

exports[`gather.mail given: [case12] a typo in a flag name when: [t0] gather.mail is invoked with --qurey then: exits 2, names the unknown flag and the allowed set 1`] = `
"✋ ConstraintError: BadRequestError: unknown flag '--qurey'

{
  "allowedFlags": [
    "--from",
    "--address",
    "--since",
    "--query",
    "--format",
    "--help"
  ],
  "hint": "run with --help for usage; a typo returns no error otherwise"
}
"
`;
